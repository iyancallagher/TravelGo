<section class="section-padding">

  <div
    class="container-custom grid lg:grid-cols-2 gap-16"
  >

    <!-- Left -->
    <div>

      <p class="text-orange-500 font-semibold mb-3">
        Contact Us
      </p>

      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        Plan Your Dream Vacation
      </h2>

      <p class="text-gray-600 mb-10">
        Contact our travel experts and start your
        unforgettable journey today.
      </p>

      <div class="space-y-6">

        <div>
          <h3 class="font-bold mb-2">
            Email
          </h3>

          <p class="text-gray-600">
            hello@travelgo.com
          </p>
        </div>

        <div>
          <h3 class="font-bold mb-2">
            WhatsApp
          </h3>

          <p class="text-gray-600">
            +62 812 3456 7890
          </p>
        </div>

        <div>
          <h3 class="font-bold mb-2">
            Office
          </h3>

          <p class="text-gray-600">
            Bali, Indonesia
          </p>
        </div>

      </div>

    </div>

    <!-- Form -->
    <div
      class="bg-white shadow-2xl rounded-3xl p-8"
    >

      <form class="space-y-6">

        <input
          type="text"
          placeholder="Your Name"
          class="w-full border border-gray-200 rounded-2xl px-5 py-4 outline-none focus:border-sky-500"
        />

        <input
          type="email"
          placeholder="Email Address"
          class="w-full border border-gray-200 rounded-2xl px-5 py-4 outline-none focus:border-sky-500"
        />

        <textarea
          rows="5"
          placeholder="Your Message"
          class="w-full border border-gray-200 rounded-2xl px-5 py-4 outline-none focus:border-sky-500"
        ></textarea>

        <button
          class="w-full bg-sky-500 hover:bg-sky-600 text-white py-4 rounded-2xl font-semibold transition"
        >
          Send Message
