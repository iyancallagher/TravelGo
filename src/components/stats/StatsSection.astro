---
const stats = [
  {
    value: "10K+",
    label: "Travelers",
  },

  {
    value: "500+",
    label: "Destinations",
  },

  {
    value: "8+",
    label: "Years Experience",
  },

  {
    value: "4.9",
    label: "Rating",
  },
];
---

<section class="py-24 bg-sky-500 text-white">

  <div
    class="container-custom grid md:grid-cols-4 gap-10 text-center"
  >

    {
      stats.map((stat) => (
        <div>

          <h3 class="text-5xl font-extrabold mb-3">
            {stat.value}
          </h3>

          <p class="text-lg text-sky-100">
            {stat.label}
          </p>

        </div>
      ))
    }

  </div>

</section>